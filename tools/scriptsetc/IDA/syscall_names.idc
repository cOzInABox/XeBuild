#include <idc.idc>

// 17559
static myGetSyscallName( funcNum ) {
		 if(funcNum == 0x0) return "HvxGetVersions";
	else if(funcNum == 0x1) return "HvxStartupProcessors";
	else if(funcNum == 0x2) return "HvxQuiesceProcessor";
	else if(funcNum == 0x3) return "KeFlushCurrentEntireTb";
	else if(funcNum == 0x4) return "HvxFlushSingleTb";
	else if(funcNum == 0x5) return "HvxRelocateAndFlush";
	else if(funcNum == 0x6) return "HvxGetSpecialPurposeRegister";
	else if(funcNum == 0x7) return "HvxSetSpecialPurposeRegister";
	else if(funcNum == 0x8) return "HvxGetSocRegister";
	else if(funcNum == 0x9) return "HvxSetSocRegister";
	else if(funcNum == 0xa) return "HvxSetTimeBaseToZero";
	else if(funcNum == 0xb) return "HvxZeroPage";
	else if(funcNum == 0xc) return "HvxFlushDcacheRange";
	else if(funcNum == 0xd) return "HvxPostOutput";
	else if(funcNum == 0xe) return "HvxEnablePerformanceMonitor";
	else if(funcNum == 0xf) return "HvxGetImagePageTableEntry";
	else if(funcNum == 0x10) return "HvxSetImagePageTableEntry";
	else if(funcNum == 0x11) return "HvxCreateImageMapping";
	else if(funcNum == 0x12) return "HvxMapImagePage";
	else if(funcNum == 0x13) return "HvxCompleteImageMapping";
	else if(funcNum == 0x14) return "HvxLoadImageData";
	else if(funcNum == 0x15) return "HvxFinishImageDataLoad";
	else if(funcNum == 0x16) return "HvxStartResolveImports";
	else if(funcNum == 0x17) return "HvxResolveImports";
	else if(funcNum == 0x18) return "HvxImage_NEW_UNK1";
	else if(funcNum == 0x19) return "HvxImage_NEW_UNK2";
	else if(funcNum == 0x1a) return "HvxFinishImageLoad";
	else if(funcNum == 0x1b) return "HvxAbandonImageLoad";
	else if(funcNum == 0x1c) return "HvxUnmapImagePages";
	else if(funcNum == 0x1d) return "HvxUnmapImage";
	else if(funcNum == 0x1e) return "HvxUnmapImageRange";
	else if(funcNum == 0x1f) return "HvxCreateUserMode";
	else if(funcNum == 0x20) return "HvxDeleteUserMode";
	else if(funcNum == 0x21) return "HvxFlushUserModeTlb";
	else if(funcNum == 0x22) return "HvxSetPowerMode";
	else if(funcNum == 0x23) return "HvxShadowBoot";
	else if(funcNum == 0x24) return "HvxBlowFuses";
	else if(funcNum == 0x25) return "HvxFsbInterrupt";
	else if(funcNum == 0x26) return "HvxLockL2";
	else if(funcNum == 0x27) return "HvxDvdAuthBuildNVPage";
	else if(funcNum == 0x28) return "HvxDvdAuthVerifyNVPage";
	else if(funcNum == 0x29) return "HvxDvdAuthRecordAuthenticationPage";
	else if(funcNum == 0x2a) return "HvxDvdAuthRecordXControl";
	else if(funcNum == 0x2b) return "HvxDvdAuthGetAuthPage";
	else if(funcNum == 0x2c) return "HvxDvdAuthVerifyAuthPage";
	else if(funcNum == 0x2d) return "HvxDvdAuthGetNextLBAIndex";
	else if(funcNum == 0x2e) return "HvxDvdAuthVerifyLBA";
	else if(funcNum == 0x2f) return "HvxDvdAuthClearDiscAuthInfo";
	else if(funcNum == 0x30) return "HvxKeysInitialize";
	else if(funcNum == 0x31) return "HvxKeysGetKeyProperties";
	else if(funcNum == 0x32) return "HvxKeysGetStatus";
	else if(funcNum == 0x33) return "HvxKeysGenerateRandomKey";
	else if(funcNum == 0x34) return "HvxKeysGetFactoryChallenge";
	else if(funcNum == 0x35) return "HvxKeysSetFactoryResponse";
	else if(funcNum == 0x36) return "HvxKeysSaveBootLoader";
	else if(funcNum == 0x37) return "HvxKeysSaveKeyVault";
	else if(funcNum == 0x38) return "HvxKeysSetKey";
	else if(funcNum == 0x39) return "HvxKeysGetKey";
	else if(funcNum == 0x3a) return "HvxKeysGetDigest";
	else if(funcNum == 0x3b) return "HvxKeysRsaPrvCrypt";
	else if(funcNum == 0x3c) return "HvxKeysHmacSha";
	else if(funcNum == 0x3d) return "HvxKeysAesCbc";
	else if(funcNum == 0x3e) return "HvxKeysDes2Cbc";
	else if(funcNum == 0x3f) return "HvxKeysDesCbc";
	else if(funcNum == 0x40) return "HvxKeysObscureKey";
	else if(funcNum == 0x41) return "HvxKeysSaveSystemUpdate";
	else if(funcNum == 0x42) return "HvxKeysExecute";
	else if(funcNum == 0x43) return "HvxDvdAuthTestMode";
	else if(funcNum == 0x44) return "HvxEnableTimebase";
	else if(funcNum == 0x45) return "HvxHdcpCalculateMi";
	else if(funcNum == 0x46) return "HvxHdcpCalculateAKsvSignature";
	else if(funcNum == 0x47) return "HvxHdcpCalculateBKsvSignature";
	else if(funcNum == 0x48) return "HvxSetRevocationList";
	else if(funcNum == 0x49) return "HvxEncryptedAllocationReserve";
	else if(funcNum == 0x4a) return "HvxEncryptedAllocationMap";
	else if(funcNum == 0x4b) return "HvxEncryptedAllocationUnmap";
	else if(funcNum == 0x4c) return "HvxEncryptedAllocationRelease";
	else if(funcNum == 0x4d) return "HvxEncryptedSweepAddressRange";
	else if(funcNum == 0x4e) return "HvxKeysExCreateKeyVault";
	else if(funcNum == 0x4f) return "HvxKeysExLoadKeyVault";
	else if(funcNum == 0x50) return "HvxKeysExSaveKeyVault";
	else if(funcNum == 0x51) return "HvxKeysExSetKey";
	else if(funcNum == 0x52) return "HvxKeysExGetKey";
	else if(funcNum == 0x53) return "HvxGetUpdateSequence";
	else if(funcNum == 0x54) return "HvxSecurityInitialize";
	else if(funcNum == 0x55) return "HvxSecurityLoadSettings";
	else if(funcNum == 0x56) return "HvxSecuritySaveSettings";
	else if(funcNum == 0x57) return "HvxSecuritySetDetected";
	else if(funcNum == 0x58) return "HvxSecurityGetDetected";
	else if(funcNum == 0x59) return "HvxSecuritySetActivated";
	else if(funcNum == 0x5a) return "HvxSecurityGetActivated";
	else if(funcNum == 0x5b) return "HvxSecuritySetStat";
	else if(funcNum == 0x5c) return "HvxGetProtectedFlags";
	else if(funcNum == 0x5d) return "HvxSetProtectedFlag";
	else if(funcNum == 0x5e) return "HvxDvdAuthGetAuthResults";
	else if(funcNum == 0x5f) return "HvxDvdAuthSetDriveAuthResult";
	else if(funcNum == 0x60) return "HvxDvdAuthSetDiscAuthResult";
	else if(funcNum == 0x61) return "HvxImageTransformImageKey";
	else if(funcNum == 0x62) return "HvxImageXexHeader";
	else if(funcNum == 0x63) return "HvxRevokeLoad";
	else if(funcNum == 0x64) return "HvxRevokeSave";
	else if(funcNum == 0x65) return "HvxRevokeUpdate";
	else if(funcNum == 0x66) return "HvxDvdAuthGetMediaId";
	else if(funcNum == 0x67) return "HvxXexActivationGetNonce";
	else if(funcNum == 0x68) return "HvxXexActivationSetLicense";
	else if(funcNum == 0x69) return "HvxXexActivationVerifyOwnership";
	else if(funcNum == 0x6a) return "HvxIptvSetBoundaryKey";
	else if(funcNum == 0x6b) return "HvxIptvSetSessionKey";
	else if(funcNum == 0x6c) return "HvxIptvVerifyOmac1Signature";
	else if(funcNum == 0x6d) return "HvxIptvGetAesCtrTransform";
	else if(funcNum == 0x6e) return "HvxIptvGetSessionKeyHash";
	else if(funcNum == 0x6f) return "HvxImageDvdEmulationMode";
	else if(funcNum == 0x70) return "HvxImageUserMode";
	else if(funcNum == 0x71) return "HvxImageShim";
	else if(funcNum == 0x72) return "HvxExpansionInstall";
	else if(funcNum == 0x73) return "HvxExpansionCall";
	else if(funcNum == 0x74) return "HvxDvdAuthFwcr";
	else if(funcNum == 0x75) return "HvxDvdAuthFcrt";
	else if(funcNum == 0x76) return "HvxDvdAuthEx";
	else if(funcNum == 0x77) return "HvxTest";

	else return form("HvxUnk_%02X", funcNum);
}
