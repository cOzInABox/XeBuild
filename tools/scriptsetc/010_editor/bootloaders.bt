BigEndian();
BitfieldRightToLeft();
typedef uchar u8;
typedef uint16 u16;
typedef uint32 u32;
typedef uint64 u64;


typedef struct {
    u32           cqw;                // Number of QWORD digits in modulus
    u32           dwPubExp;           // Public exponent
    u64           qwReserved;         // Reserved (was qwMI)
} XECRYPT_RSA;

typedef struct {
    XECRYPT_RSA     Rsa;                // Common header
    u64           aqwM[32];           // [BnQwNe] Modulus
} XECRYPT_RSAPUB_2048;

typedef struct {                        // [BnQwBe]
    u64           aqwPad[28];         // Padding
    u8            bOne;               // 0x01
    u8            abSalt[10];         // Salt
    u8            abHash[20];         // Hash
    u8            bEnd;               // 0xBC
} XECRYPT_SIG;

typedef struct _BLDR{
	u16 Magic; // 0
	u16 Build; // 2
	u16 Qfe; // 4
	u16 Flags; // 6
	u32 Entry; // 8
	u32 Size; // 12
} BLDR;

