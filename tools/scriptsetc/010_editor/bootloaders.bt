/* ****** for CE ***** */
typedef struct CeLzxEntry {
    ushort compSz;
    ushort decompSz;
    if(compSz > 1)
        uchar pdat[compSz];
};

string CompSzCeComment( CeLzxEntry& cmp, u32 curr )
{
	string str;
	sprintf(str, "0x%x-0x%x", curr, curr+cmp.decompSz);
	return str;
}

typedef struct BLDR_5BL{  // _BLDR_LZX_IMAGE
	BLDR header;
	u8 abNonce[0x10]; // 16
	u64 qwImageAddr; // 32
	u32 dwImageSize; // 40
	u32 dwPad; // 44
}; // 48

/* ****** for CF ***** */

typedef struct CfPatchEntry {
    uint oldAddr;
    uint newAddr;
    ushort decomSz;
    ushort compSz;
    if(compSz > 1)
        uchar pdat[compSz];
};

string CompSzCfComment( CfPatchEntry& cmp )
{
    if( cmp.compSz == 0 )
        return "zero fill";
    else if (cmp.compSz == 1)
        return "byte copy";
    else
        return "delta patch";
}

typedef struct BLDR_6BL_PERBOX{
	u16 cBlocks; // 0
	u16 aBlocks[0xDF]; // 2
}; // 448

