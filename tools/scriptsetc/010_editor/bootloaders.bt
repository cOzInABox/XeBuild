	// };
	XECRYPT_SIG Sig; // 560
	u8 abNonce7bl[0x10]; // 816
	u8 abDigest7bl[0x14]; // 832
	u8 padding[0xc];
}; // 854+padding

/* ****** for CG ***** */
typedef struct BLDR_7BL{ // CG
	BLDR header;
	u8 abNonce[0x10]; // 16
	u32 dwSourceImageSize; // 32
	u8 abSourceDigest[0x14]; // 36
	u32 dwTargetImageSize; // 56
	u8 abTargetDigest[0x14]; // 60
}; // 80

/* ****** ***** ***** */

local u32 temp <hidden=true>;
temp = ReadShort(0);
FSeek(0);

if((temp&0xF)==2)
{
    BLDR_2BL CbSbBody;
	u8 body[CbSbBody.header.Size - sizeof(BLDR_2BL)];
}
else if((temp&0xF)==3)
{
	BLDR_3BL CcBody;
	u8 body[CcBody.header.Size - sizeof(BLDR_3BL)];
}
else if((temp&0xF)==4)
{
	BLDR_4BL CdSdBody;
	u8 body[CdSdBody.header.Size - sizeof(BLDR_4BL)];
}
else if((temp&0xF)==5)
{
	BLDR_5BL CeSeBody;
	temp = 0;
	while(FTell() < (CeSeBody.header.Size-12))
	{
		CeLzxEntry ent; // <comment=CompSzCeComment(&ent, temp)>
		temp = temp+ent.decompSz;
	}
	Printf("CE decompressed size: 0x%x bytes\n", temp);
}
else if((temp&0xF)==6)
	BLDR_6BL CfSfBody;
else if((temp&0xF)==7)
{
	BLDR_7BL CgSgBody;
	while(FTell() < (CgSgBody.header.Size-12))
		CfPatchEntry ent<comment=CompSzCfComment>;
}
