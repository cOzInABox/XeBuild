typedef struct _XCONTENT_METADATA_INSTALLER(DWORD metaType) { 
	enum INSTALLER_METADATA_TYPE MetaDataType; // 0x0 sz:0x4
	if(metaType == INSTALLER_METADATA_TYPE_SYSTEM_UPDATE)
		XCONTENT_METADATA_INSTALLER_TITLE_UPDATE TitleUpdate;
	else if(metaType == INSTALLER_METADATA_TYPE_TITLE_UPDATE)
		XCONTENT_METADATA_INSTALLER_SYSTEM_UPDATE SystemUpdate;
	else
		XONLINECONTENT_RESUME_HEADER ResumeHeader;

} XCONTENT_METADATA_INSTALLER; // size 5620



//local DWORD temp; // <hidden=true>
local DWORD isSvod<hidden=true>;
local DWORD isInstaller<hidden=true>;
local DWORD HeaderSizeRounded;

isSvod = ReadUInt(0x3A9);
isInstaller = ReadUInt(0x971A);
FSeek(0);
XCONTENT_HEADER hdr;
XCONTENT_METADATA meta(isSvod);

if(isInstaller != 0)
{
	FSeek(0x971A);
	XCONTENT_METADATA_INSTALLER xmi(isInstaller);
}
// we need to work out the size of the hashed area for media ID
// its basically hdr.SizeOfHeaders rounded to the next highest 0x1000 (4k) page size, minus 0x344 (size of the headers up to the end of hdr.SizeOfHeaders)
HeaderSizeRounded = ((hdr.SizeOfHeaders+0xFFF)&~0xFFF);
FSeek(0x22c);
BYTE SignatureHashData[0x118];
FSeek(0x344);
BYTE MediaIdHashData[HeaderSizeRounded-0x344];

if(isSvod)
    Printf("Container is SVOD\n");
else
    Printf("Container is STFS\n");
Printf("TITLEID %08X\n", meta.ExecutionId.TitleID);
Printf("XCONTENT type %08X\n", meta.ContentType);
Printf("Path: %08X\\%08X\n", meta.ExecutionId.TitleID, meta.ContentType);