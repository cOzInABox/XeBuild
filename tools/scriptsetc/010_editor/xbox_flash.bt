BigEndian();
BitfieldRightToLeft();
typedef uchar u8;
typedef uint16 u16;
typedef uint32 u32;
typedef uint64 u64;

typedef struct _XECRYPT_SIG{
	u64 aqwPad[0x1C];
	u8 bOne;
	u8 abSalt[0xA];
	u8 abHash[0x14];
	u8 bEnd;
} XECRYPT_SIG; // 256

typedef struct _XECRYPT_RSA{
	u32 cqw;
	u32 dwPubExp;
	u64 qwReserved;
} XECRYPT_RSA; // 16

typedef struct _XECRYPT_RSAPUB_2048{
	XECRYPT_RSA Rsa;
	u64 aqwM[0x20];
} XECRYPT_RSAPUB_2048; // 272

typedef struct _BLDR{
	u16 Magic; // 0
	u16 Build; // 2
	u16 Qfe; // 4
	u16 Flags; // 6
	u32 Entry; // 8
	u32 Size; // 12
} BLDR;

typedef struct _BLDR_FLASH{
	BLDR header; // 16 - 0
	char achCopyright[0x40]; // 16
	u8 abReserved[0x10]; // 80
	u32 dwKeyVaultSize; // 96
	u32 dwSysUpdateAddr; // 100
	u16 wSysUpdateCount; // 104
	u16 wKeyVaultVersion; // 106
	u32 dwKeyVaultAddr; // 108
	u32 dwSysUpdateSlotSize; // 112 dwFileSystemAddr << actually the size of one patch slot
	u32 dwSmcConfigAddr; // 116
	u32 dwSmcBootSize; // 120
	u32 dwSmcBootAddr; // 124
} BLDR_FLASH; // 128

typedef struct BLDR_DEV_KDNET{
	u16 wKdNetMagic;
	u16 unused1;
	u32 unused2;
	u32 dwKdNetDataOffset;
	u32 dwKdNetDataSize;
	u32 unknown1;
	u32 KdNetXboxIp;
	u8 KdNetMacID[6];
	u16 KdNetPort;
	u32 KdNetHostIp;
	u8 padding[24];
};

typedef struct _BLDR_2BL_CB{ // CB/SB
	BLDR header; // 16 - 0
	u8 abNonce[0x10]; // 16
//	union {
//		struct {
		u32 dwUpdateSequenceBase; // 32
		u8 abReserved[0xC]; // 36
		u8 abPerBoxDigest[0x10]; // 48
//		};
//		u8 abPerBoxData[0x20]; // 32
//		u64 aqwPerBoxData[0x4]; // 32
//	};
	XECRYPT_SIG Sig; // 256 - 64
	u8 abAesInvData[0x110]; // 272 - 320
	u64 qwPostOutAddr; // 592
	u64 qwSbFlashAddr; // 600
	u64 qwSocMmioAddr; // 608
	XECRYPT_RSAPUB_2048 RsaPub; //272 - 616
	u8 abNonce3bl[0x10]; // 888
	u8 abSalt3bl[0xA]; // 904
	u8 abSalt4bl[0xA]; // 914
	u8 abDigest4bl[0x14]; // 924
//	union Sequence{
//		struct SequenceSt{
			u8 bConsoleType; // 944
			u8 bConsoleSequence; // 945
			u16 wConsoleSequenceAllow; // 946
//		};
//		u32 dwConsoleTypeSeqAllow; // 944
//	};
	u8 pad[0xC];
} BLDR_2BL; // 948+padding

typedef struct _BLDR_3BL_CC{ // SC
	BLDR header; // 16 - 0
	u8 abNonce[0x10]; // 16
	XECRYPT_SIG Sig; // 256 - 32
} BLDR_3BL; // 288

typedef struct _BLDR_4BL_CD{ // CD/SC
	BLDR header; // 16 - 0
	u8 abNonce[0x10]; // 16
//	union{
		XECRYPT_SIG Sig; // 256 - 32
//		u8 abPerBoxData[0x100]; // 256 - 32
